# Which model reads the conference source pages: gemini | claude | ollama | mlx | none
LLM_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Claude (key: https://platform.claude.com/settings/keys) — paid per token
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Local models via Ollama (https://ollama.com) — free, runs on your Mac
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b

# Local models via Apple MLX (Apple Silicon only): pip install mlx-lm; mlx_lm.server --model <model>
# MLX_URL=http://localhost:8080
# MLX_MODEL=mlx-community/gemma-3-12b-it-4bit

# Local model tuning (smaller models do better with smaller chunks)
# LOCAL_CHUNK_CHARS=12000
# LOCAL_CONTEXT_TOKENS=16384
# LOCAL_MAX_OUTPUT_TOKENS=4096

# Optional
# CONFERENCES_DB=data/conferences.db
